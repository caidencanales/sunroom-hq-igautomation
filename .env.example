# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# Sending mailbox. Gmail/Google Workspace: smtp.gmail.com / imap.gmail.com with an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Tip: send from a secondary domain (e.g. trysunroomhq.com) so your main domain's reputation is safe.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=caiden@yourdomain.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=caiden@yourdomain.com
IMAP_HOST=imap.gmail.com

# Shown in the email footer (INCLUDE_EMAIL_FOOTER in config.py)
BUSINESS_ADDRESS=123 Main St, Austin, TX 78701

# Daily summary + tracker goes here
REPORT_TO=caidencanales@gmail.com
